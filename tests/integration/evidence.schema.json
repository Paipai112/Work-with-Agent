{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only GitHub repository evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_kind", "target", "expected_installation_id", "repository", "default_branch", "snapshot", "labels", "rulesets", "branch_protection", "issue_template", "pr_template", "codeowners", "workflow", "workflow_runs", "installation", "pull_requests"],
  "allOf": [{"if": {"properties": {"evidence_kind": {"const": "read-only-gh-api"}}}, "then": {"required": ["observed_at"]}, "else": {"not": {"required": ["observed_at"]}}}],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_kind": {"enum": ["read-only-gh-api", "offline-fixture"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "target": {"type": "object", "additionalProperties": false, "required": ["host", "owner", "name"], "properties": {"host": {"type": "string"}, "owner": {"type": "string"}, "name": {"type": "string"}}},
    "expected_installation_id": {"type": "string", "minLength": 1},
    "repository": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"type": "object", "additionalProperties": false, "required": ["status", "id", "name", "full_name", "default_branch", "permission"], "properties": {"status": {"const": "observed"}, "id": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}, "full_name": {"type": "string", "minLength": 3}, "default_branch": {"type": "string", "minLength": 1}, "permission": {"$ref": "#/$defs/permission"}}}]},
    "default_branch": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"type": "object", "additionalProperties": false, "required": ["status", "name", "sha"], "properties": {"status": {"const": "observed"}, "name": {"type": "string", "minLength": 1}, "sha": {"$ref": "#/$defs/sha"}}}]},
    "snapshot": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"type": "object", "additionalProperties": false, "required": ["status", "repository_id", "repository_full_name", "default_branch", "commit_sha"], "properties": {"status": {"const": "observed"}, "repository_id": {"type": "integer", "minimum": 1}, "repository_full_name": {"type": "string", "minLength": 3}, "default_branch": {"type": "string", "minLength": 1}, "commit_sha": {"$ref": "#/$defs/sha"}}}]},
    "labels": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"type": "object", "additionalProperties": false, "required": ["status", "names"], "properties": {"status": {"const": "observed"}, "names": {"type": "array", "items": {"type": "string"}}}}]},
    "rulesets": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "managed_fields"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "managed_fields": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"$ref": "#/$defs/review_fields"}]}}}}]},
    "branch_protection": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"type": "object", "additionalProperties": false, "required": ["status", "required_status_checks", "required_approving_review_count"], "properties": {"status": {"const": "observed"}, "required_status_checks": {"$ref": "#/$defs/check_names"}, "required_approving_review_count": {"$ref": "#/$defs/review_count"}}}]},
    "issue_template": {"$ref": "#/$defs/content", "properties": {"path": {"const": ".github/ISSUE_TEMPLATE/agent-task.yml"}}},
    "pr_template": {"$ref": "#/$defs/content", "properties": {"path": {"const": ".github/PULL_REQUEST_TEMPLATE/agent-change.md"}}},
    "codeowners": {"$ref": "#/$defs/content", "properties": {"path": {"enum": [".github/CODEOWNERS", "CODEOWNERS", "docs/CODEOWNERS"]}}},
    "workflow": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"type": "object", "additionalProperties": false, "required": ["status", "id", "state"], "properties": {"status": {"const": "observed"}, "id": {"$ref": "#/$defs/id"}, "state": {"type": "string", "minLength": 1}}}]},
    "workflow_runs": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"type": "object", "additionalProperties": false, "required": ["status", "runs"], "properties": {"status": {"const": "observed"}, "runs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "conclusion", "head_sha"], "properties": {"id": {"$ref": "#/$defs/id"}, "status": {"type": "string", "minLength": 1}, "conclusion": {"type": ["string", "null"]}, "head_sha": {"$ref": "#/$defs/sha"}}}}}}]},
    "installation": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"type": "object", "additionalProperties": false, "required": ["status", "actual_id", "matches_expected", "path", "sha", "ref"], "properties": {"status": {"const": "observed"}, "actual_id": {"type": "string", "minLength": 1}, "matches_expected": {"type": "boolean"}, "path": {"const": ".github/agent-collaboration/managed-resources.yml"}, "sha": {"$ref": "#/$defs/sha"}, "ref": {"$ref": "#/$defs/sha"}}}]},
    "pull_requests": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"type": "object", "additionalProperties": false, "required": ["status", "open_prs"], "properties": {"status": {"const": "observed"}, "open_prs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["number", "mergeability"], "properties": {"number": {"$ref": "#/$defs/id"}, "mergeability": {"$ref": "#/$defs/mergeability"}}}}}}]}
  },
  "$defs": {
    "id": {"type": "integer", "minimum": 1},
    "check_names": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "review_count": {"type": ["integer", "null"], "minimum": 0},
    "review_fields": {"type": "object", "additionalProperties": false, "required": ["required_status_checks", "required_approving_review_count"], "properties": {"required_status_checks": {"$ref": "#/$defs/check_names"}, "required_approving_review_count": {"$ref": "#/$defs/review_count"}}},
    "permission": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"type": "object", "additionalProperties": false, "required": ["status", "admin", "maintain", "push"], "properties": {"status": {"const": "observed"}, "admin": {"type": "boolean"}, "maintain": {"type": "boolean"}, "push": {"type": "boolean"}}}]},
    "mergeability": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"type": "object", "additionalProperties": false, "required": ["status", "mergeable", "mergeable_state"], "properties": {"status": {"const": "observed"}, "mergeable": {"type": "boolean"}, "mergeable_state": {"type": "string", "minLength": 1}}}]},
    "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "content": {"oneOf": [{"$ref": "#/$defs/unverified"}, {"type": "object", "additionalProperties": false, "required": ["status", "path", "sha", "ref"], "properties": {"status": {"const": "observed"}, "path": {"type": "string", "minLength": 1}, "sha": {"$ref": "#/$defs/sha"}, "ref": {"$ref": "#/$defs/sha"}}}]},
    "unverified": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "unverified"}, "reason": {"type": "string"}, "http_status": {"type": "integer", "minimum": 100, "maximum": 599}}}
  }
}
